{
  "name": "openbadge-inspector",
  "version": "0.1.2",
  "private": true,
  "description": "Firefox extension that finds Open Badges baked into images and shows whether they are valid.",
  "license": "EUPL-1.2",
  "author": "Damian Fajfer <damian@fajfer.org>",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "npm run build && web-ext run -s dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-no-comments.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ext:lint": "web-ext lint -s dist",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "fixtures": "node tests/fixtures/build-fixtures.ts",
    "demo": "npm run build && node scripts/demo.ts",
    "inspect-pages": "npm run build && node tests/e2e/manual/real-pages.ts"
  },
  "dependencies": {
    "jsonld": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^24.19.2",
    "@types/selenium-webdriver": "^4.35.7",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.52.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
